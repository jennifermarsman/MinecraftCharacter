PORT=3001
HOST=127.0.0.1
# demo never calls a model; live sends the normalized photo to your Foundry deployment.
# placeholder preserves the manual editor without enabling photo analysis.
DECISION_MODE=demo
# Resource root or full /providers/microsoft/v1/systemone URL (HTTPS).
DECISION_ENDPOINT=
# The deployment name of an image-capable Microsoft Decision 1.1 model.
DECISION_DEPLOYMENT=
# entra uses DefaultAzureCredential (az login locally, managed identity in Azure).
# For API keys instead, set DECISION_AUTH=api-key and fill DECISION_API_KEY.
DECISION_AUTH=entra
DECISION_API_KEY=
DECISION_TIMEOUT_MS=60000
